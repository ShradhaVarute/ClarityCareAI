# Copy this file to .env and fill in real values for local development.
# In production (Render, etc.), set these as real environment variables —
# do not rely on a .env file being present.

# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/claritycare_db

# Secret used to sign JWTs. MUST be set to a fixed, secret value in any real
# deployment — if unset, the app falls back to a random key generated at
# process startup, which invalidates all sessions on every restart and
# breaks auth if you run more than one worker process.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
